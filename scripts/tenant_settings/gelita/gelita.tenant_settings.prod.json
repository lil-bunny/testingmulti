{
  "prompts": {
    "load_tendering.carrier_ack": "carrier-ack-classify:production"
  },
  "load_tendering": {
    "ftl": {
      "escalate_tender": {
        "escalation_cc": [
          "Tonya.Jackson@gelita.com"
        ],
        "escalation_bcc": [
          "gelita-qa@freightx.ai"
        ],
        "escalation_email_body": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\" /><title>Gelita FTL Tender Escalation</title></head>\n<body style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #111;\">\n<p style=\"margin-bottom: 12px;\"><strong>FTL tender escalation</strong></p>\n<p style=\"margin-bottom: 8px;\">No carrier acknowledgment received within the expected window.</p>\n<p style=\"margin-bottom: 0;\">Order #: <strong>{order_number}</strong></p>\n</body>\n</html>",
        "escalation_notify_email": [
          "taylor.hudson@gelita.com"
        ],
        "escalation_email_subject": "Tender escalation (order {order_number})"
      },
      "send_tender_email": {
        "vendor_cc": [
          "Tonya.Jackson@gelita.com"
        ],
        "vendor_bcc": [
          "gelita-qa@freightx.ai"
        ],
        "vendor_email": [
          "taylor.hudson@gelita.com"
        ],
        "email_subject": "PICK UP REQUEST # {order_number} PO# {po_number}",
        "email_template_html": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\" /><title>Gelita FTL Tender Request</title></head>\n<body style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #111;\">\n<p style=\"margin-bottom: 18px;\"><strong>Deliver to:</strong><br />{delivery_address}</p>\n<p style=\"margin-bottom: 12px;\">Order # {order_number}<br />Customer PO # {customer_po}</p>\n<p style=\"margin-bottom: 12px;\">Ship date: {ship_date}<br />Delivery date: {delivery_date}</p>\n<p style=\"margin-bottom: 12px;\">{products_block}</p>\n</body>\n</html>"
      },
      "send_tender_reminder": {
        "reminder_body": "<!DOCTYPE html><html><head><meta charset=\"utf-8\" /></head><body><p>Following up on the request.</p><p>Thanks</p></body></html>"
      }
    },
    "ltl": {
      "escalate_tender": {
        "escalation_cc": [
          "taylor.hudson@gelita.com"
        ],
        "escalation_bcc": [
          "gelita-qa@freightx.ai"
        ],
        "escalation_email_body": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\" /><title>Gelita LTL Tender Escalation</title></head>\n<body style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #111;\">\n<p style=\"margin-bottom: 12px;\"><strong>LTL tender escalation</strong></p>\n<p style=\"margin-bottom: 8px;\">No carrier acknowledgment received within the expected window.</p>\n<p style=\"margin-bottom: 0;\">Order #: <strong>{order_number}</strong></p>\n</body>\n</html>",
        "escalation_notify_email": [
          "Tonya.Jackson@gelita.com"
        ],
        "escalation_email_subject": "Tender escalation (order {order_number})"
      },
      "send_tender_email": {
        "vendor_cc": [
          "taylor.hudson@gelita.com"
        ],
        "vendor_bcc": [
          "gelita-qa@freightx.ai"
        ],
        "vendor_email": [
          "Tonya.Jackson@gelita.com"
        ],
        "email_subject": "PICK UP REQUEST # {order_number} PO# {po_number}",
        "email_template_html": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\" /><title>BOL Request Template</title></head>\n<body style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #111;\">\n<p style=\"margin-bottom: 4px;\"><span style=\"background-color: #fff176; font-weight: bold; padding: 2px 4px;\">Please Provide Your BOL by 1300 CST day prior of shipment or GELITA will use their own.</span> <span style=\"color: #555;\">\"Make sure to include your sales coordinator and the whole logistics team (Chris Alter, Taylor Hudson, &amp; Tonya Jackson) when sending your BOL\"</span></p>\n<br />\n<p style=\"margin-bottom: 18px;\"><strong>Pickup address:</strong><br />{pickup_address}</p>\n<p style=\"margin-bottom: 18px;\"><strong>Deliver to:</strong><br />{delivery_address}</p>\n<p style=\"margin-bottom: 0;\">Order #{order_number}<br />Customer PO #{customer_po}<br />Ship date: {ship_date}</p>\n<br />\n<p style=\"margin-top: 0;\">{products_block}</p>\n<p style=\"margin-top: 0;\">NMFC Code 73260-00 Class 70<br />Non-Stackable<br />Non-Hazardous</p>\n<br />\n<p><strong>Loading hours 1300-1600 day of shipment.</strong></p>\n</body>\n</html>"
      },
      "send_tender_reminder": {
        "reminder_body": "<!DOCTYPE html><html><head><meta charset=\"utf-8\" /></head><body><p>Following up on the request.</p><p>Thanks</p></body></html>"
      }
    },
    "reminders": {
      "variants": {
        "ftl": [
          {
            "step": 1,
            "event_type": "reminder_due",
            "delay_hours": 24
          },
          {
            "step": 2,
            "event_type": "reminder_due",
            "delay_hours": 48
          },
          {
            "event_type": "escalation_due",
            "delay_hours": 72
          }
        ],
        "ltl": [
          {
            "step": 1,
            "event_type": "reminder_due",
            "delay_hours": 24
          },
          {
            "step": 2,
            "event_type": "reminder_due",
            "delay_hours": 48
          },
          {
            "event_type": "escalation_due",
            "delay_hours": 72
          }
        ]
      },
      "variant_selector": "load_type",
      "skip_sub_statuses": [
        "accepted",
        "rejected"
      ],
      "expire_grace_hours": 2,
      "schedule_on_event_type": "carrier_email_received",
      "delivery_cutoff": {
        "local_time": "13:00",
        "timezone": "America/Chicago"
      }
    },
    "domestic_delivery": {
      "country_iso_codes": [
        "US",
        "CA",
        "MX"
      ]
    },
    "tender_calculate": {
      "pallet_profiles": {
        "european": {
          "match": [
            "European Pallet",
            "European pallet"
          ],
          "threshold": 8,
          "weight_lbs": 56,
          "default": false
        },
        "wood_4way": {
          "match": [
            "4-way wood",
            "2-way wood"
          ],
          "threshold": 8,
          "weight_lbs": 50,
          "default": true
        },
        "plastic_4way": {
          "match": [
            "4-way plastic",
            "4 way plastic"
          ],
          "threshold": 8,
          "weight_lbs": 66,
          "default": false
        }
      },
      "gelita_pickup_address": {
        "city": "Sergeant Bluff",
        "name": "GELITA USA",
        "state": "IA",
        "country": "United States",
        "address1": "2445 Port Neal Industrial Road",
        "postal_code": "51054"
      }
    },
    "workflow_error_alerts": {
      "enabled": true,
      "channels": [
        {
          "cc": [
            "taylor.hudson@gelita.com"
          ],
          "to": [
            "Tonya.Jackson@gelita.com"
          ],
          "bcc": [
            "gelita-qa@freightx.ai"
          ],
          "channel": "email",
          "subject": "Exception: Gelita Order Processing Failure PO {customer_po}",
          "body_template": "<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\" /><title>Gelita Order Processing Failure</title></head>\n<body style=\"font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #111;\">\n<p>Dear Team,</p>\n<p>We are unable to process the below Gelita order due to an exception.</p>\n<p><strong>Reason for Failure:</strong><br />{failure_reason}</p>\n<p><strong>Order ID:</strong> {order_number}</p>\n<p>Regards,<br />Ana</p>\n</body>\n</html>"
        }
      ]
    }
  },
  "enabledProcesses": [
    "load_tendering"
  ],
  "inbound_routing_emails": [
    "anaai.freightx@gelita.com"
  ],
  "ana_at_gelita_account_id": "T-PR3y6ESoGobYEQKXsX8Q"
