      "template_html": "<html><body style=\"font-family: Arial, sans-serif; color:#333;\"><p>Confirmed for load {load_id}.</p><p>Reference: {reference_number}<br>Customer: {customer_name}<br>Delivery: {confirmed_delivery_at}</p><p>Thank you.</p></body></html>",
