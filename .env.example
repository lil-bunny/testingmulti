ENV=dev
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=freightx-local

# Pydantic Logfire (paste your write token to enable tracing; leave blank to disable)
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=freightx
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=freightx
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

WORKFLOW_CORRELATION_TABLE=workflow_correlation
REMINDER_1_HOURS=24
REMINDER_2_HOURS=48
# POD_REMINDER_EMAIL_BODY=Please send pod

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Unipile (optional — thread reminder emails; leave blank to skip real sends in Celery)
# UNIPILE_API_KEY=
# UNIPILE_BASE_URL=https://api16.unipile.com:14674
# UNIPILE_ACCOUNT_ID=

# LangGraph Studio defaults (also default workflow tenant for Turvo webhooks if no ?tenant_id=)
STUDIO_TENANT_ID=t3ra
STUDIO_WORKFLOW_NAME=pod_lifecycle


# Override workflow tenant for webhooks only (optional)
# TURVO_WEBHOOK_WORKFLOW_TENANT_ID=t3ra

# Turvo tokens live in tenants.config JSON (see TENANTS_TABLE). Each row must have app_user_id.
TENANTS_TABLE=tenants
# TURVO_PUBLICAPI_URL=https://my-sandbox-publicapi.turvo.com
# TURVO_PUBLICAPI_CLIENT_ID=
# TURVO_PUBLICAPI_CLIENT_SECRET=
# TURVO_X_API_KEY=
# TURVO_TENANT_REF=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TURVO_OAUTH_ENCRYPTION_KEY=
