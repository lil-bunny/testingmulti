ENV=dev

OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=freightx-local

# Pydantic Logfire (paste your write token to enable tracing; leave blank to disable)
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=freightx
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_V2=true
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=freightx
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

WORKFLOW_CORRELATION_TABLE=workflow_correlation
DOCUMENTS_TABLE=documents
DOCUMENT_ANALYSIS_TABLE=document_analysis
REMINDER_0_HOURS=0
REMINDER_1_HOURS=24
REMINDER_2_HOURS=48
# Sub-hour: decimal hours (30s ≈ 0.00833333, 5m ≈ 0.08333333). Integer values still OK.
# POD_REMINDER_EMAIL_BODY=Please send pod

REMINDER_EXPIRE_GRACE_HOURS=2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

TURVO_APP_URL=https://app.turvo.com
TURVO_PUBLICAPI_URL=https://publicapi.turvo.com
TURVO_PUBLICAPI_CLIENT_ID=
TURVO_PUBLICAPI_CLIENT_SECRET=
TURVO_USERNAME=
TURVO_PASSWORD=
TURVO_X_API_KEY=

UNIPILE_API_KEY=
UNIPILE_DSN=
OAUTH_REDIRECT_URI=

UNIPILE_WEBHOOK_SECRET=

TURVO_APP_URL=https://app.turvo.com
TURVO_PUBLICAPI_URL=https://publicapi.turvo.com
TURVO_PUBLICAPI_CLIENT_ID=
TURVO_PUBLICAPI_CLIENT_SECRET=
TURVO_USERNAME=
TURVO_PASSWORD=
TURVO_X_API_KEY=

UNIPILE_API_KEY=
UNIPILE_DSN=
OAUTH_REDIRECT_URI=

BUCKET_ENDPOINT=
BUCKET_ID=
BUCKET_KEY=
BUCKET_NAME=
BUCKET_REGION=us-west-2
BUCKET_PRESIGN_EXPIRES_SECONDS=600
# S3 path segment under freightx/ for ratecon PDF uploads (see app/tools/ratecon.py)
BUCKET_RATECON_ATTACHMENTS_FOLDER=ratecon_attachments

UNIPILE_WEBHOOK_SECRET=

# Unipile (optional — thread reminder emails; leave blank to skip real sends in Celery)
# UNIPILE_API_KEY=
# UNIPILE_BASE_URL=https://api16.unipile.com:14674
# UNIPILE_ACCOUNT_ID=

# LangGraph Studio defaults (also default workflow tenant for Turvo webhooks if no ?tenant_id=)
STUDIO_TENANT_ID=t3ra
STUDIO_WORKFLOW_NAME=pod_lifecycle


# Override workflow tenant for webhooks only (optional)
# TURVO_WEBHOOK_WORKFLOW_TENANT_ID=t3ra

# Turvo tokens live in tenants.config JSON (see TENANTS_TABLE). Each row must have app_user_id.
TENANTS_TABLE=tenants
# TURVO_PUBLICAPI_URL=https://my-sandbox-publicapi.turvo.com
# TURVO_PUBLICAPI_CLIENT_ID=
# TURVO_PUBLICAPI_CLIENT_SECRET=
# TURVO_X_API_KEY=
# TURVO_TENANT_REF=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TURVO_OAUTH_ENCRYPTION_KEY=
