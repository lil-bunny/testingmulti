ENV=dev

# LOGFIRE_TOKEN=
# LOGFIRE_SERVICE_NAME=freightx

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=freightx-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=freightx
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

FREIGHTX_API_BASE_URL=http://localhost:8001
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sub-hour: decimal hours (30s ≈ 0.00833333, 5m ≈ 0.08333333). Integer values still OK.
REMINDER_0_HOURS=0
REMINDER_1_HOURS=24
REMINDER_2_HOURS=48

REMINDER_EXPIRE_GRACE_HOURS=2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

UNIPILE_API_KEY=
UNIPILE_BASE_URL=
# Optional legacy fallback for Unipile sender account; T3RA POD mail uses tenants.settings.mikey_account_id
UNIPILE_ACCOUNT_ID=
OAUTH_REDIRECT_URI=
UNIPILE_WEBHOOK_SECRET=

TURVO_APP_URL=https://app.turvo.com
TURVO_PUBLICAPI_URL=https://publicapi.turvo.com
TURVO_PUBLICAPI_CLIENT_ID=
TURVO_PUBLICAPI_CLIENT_SECRET=
TURVO_USERNAME=
TURVO_PASSWORD=
TURVO_X_API_KEY=

# tenants.settings.tms.pod_document_lookup_id — Turvo POD document type lookupId (e.g. 20271627 sandbox)

TURVO_WEBHOOK_WORKFLOW_TENANT_ID=t3ra # Override workflow tenant for webhooks only (optional)

BUCKET_ENDPOINT=
BUCKET_ID=
BUCKET_KEY=
BUCKET_NAME=
BUCKET_REGION=us-west-2
BUCKET_PRESIGN_EXPIRES_SECONDS=600


# LangGraph Studio defaults (also default workflow tenant for Turvo webhooks if no ?tenant_id=)
STUDIO_TENANT_SLUG=t3ra
STUDIO_WORKFLOW_NAME=pod_lifecycle
